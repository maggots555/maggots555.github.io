---
import { herramientas } from "../data/herramientas";
---

<section id="herramientas" class="block-dim py-16 desk:py-24">
  <div class="wrap">
    <header class="section-head">
      <h2 class="reveal">Herramientas</h2>
      <p class="reveal">Lenguajes, infraestructura y el copiloto con el que escribo.</p>
    </header>

    {/* Cuatro columnas de créditos: frontend, backend, infra, copiloto. */}
    <div class="pegboard grid grid-cols-1 gap-8 compact:grid-cols-2 desk:grid-cols-4">
      {
        herramientas.map((capa) => (
          <div class="credit-col reveal">
            <h3>{capa.titulo}</h3>
            <ul>
              {capa.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
