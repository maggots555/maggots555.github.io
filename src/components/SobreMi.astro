---
/**
 * Bio a la izquierda, recorrido a la derecha.
 * El hueco vacío en escritorio se llena con la línea de tiempo
 * (es una secuencia real: taller → datos → PHP → Django).
 * El “haz” que baja por el riel es el mismo lenguaje de luz del hero.
 */
import Ticket from "./Ticket.astro";

const recorrido = [
  {
    periodo: "2010–2013",
    titulo: "CONALEP",
    detalle: "Técnico en informática",
  },
  {
    periodo: "2017–2019",
    titulo: "Operación",
    detalle: "SIC México: órdenes, logística, garantías",
  },
  {
    periodo: "2019–2022",
    titulo: "Datos",
    detalle: "Tiempos de reparación, fallas e inventario",
  },
  {
    periodo: "2023",
    titulo: "PHP",
    detalle: "El primer sistema, cuando Excel ya no daba",
  },
  {
    periodo: "Hoy",
    titulo: "SIGMA",
    detalle: "Django, en producción",
  },
];
---

<section id="sobre-mi" class="py-16 desk:py-24">
  <div class="wrap">
    <div class="bio-grid">
      <div>
        <header class="section-head">
          <h2 class="reveal">Sobre mí</h2>
          <p class="reveal">
            La historia corta: empecé en operación y datos, y de ahí pasé a construir software.
          </p>
        </header>

        <Ticket>
          <p>
            Estudié la carrera técnica en informática en CONALEP (2010–2013). De 2017
            a 2019 coordiné operaciones en SIC México (órdenes, logística, garantías).
            De 2019 a 2022 trabajé análisis de datos del mismo taller: tiempos de
            reparación, fallas e inventario.
          </p>
          <p>
            En 2023 empecé a construir el sistema que el Excel ya no aguantaba.
            Primero un prototipo en <strong class="text-papel">PHP, MySQL y XAMPP</strong> (el stack con
            el que aprendí). Después reconstruí el flujo en <strong class="text-papel">Django</strong>:
            eso es SIGMA, un sistema en producción y la obra con la que me presento.
          </p>
        </Ticket>
      </div>

      <aside class="recorrido reveal" aria-label="Recorrido">
        <p class="recorrido-label">Recorrido</p>
        {/*
          SVG: una línea vertical. Al entrar en pantalla se “dibuja”
          (stroke-dashoffset), como si la luz bajara por el margen.
        */}
        <svg class="recorrido-svg" viewBox="0 0 8 100" preserveAspectRatio="none" aria-hidden="true">
          <line class="recorrido-stroke" x1="4" y1="0" x2="4" y2="100" />
        </svg>
        <span class="recorrido-haz" aria-hidden="true"></span>
        <ol>
          {
            recorrido.map((paso) => (
              <li>
                <span class="recorrido-periodo">{paso.periodo}</span>
                <strong>{paso.titulo}</strong>
                <span class="recorrido-detalle">{paso.detalle}</span>
              </li>
            ))
          }
        </ol>
      </aside>
    </div>
  </div>
</section>
