---
/**
 * Panel editorial (el hueco de contenido de cada bloque).
 *
 * EXPLICACIÓN:
 * Antes era una ficha de papel con perforación. Ahora es solo un
 * contenedor: el diseño vive en global.css (.panel).
 * `<slot />` es el interior: títulos, párrafos, botones...
 * `class` extra sirve para panel-hero, panel-end, etc.
 */
interface Props {
  class?: string;
}

const { class: extra = "" } = Astro.props;
---

<article class:list={["panel", extra]}>
  <slot />
</article>
