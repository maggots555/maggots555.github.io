---
import { sitio } from "../data/sitio";
import Ticket from "./Ticket.astro";
import Stamp from "./Stamp.astro";

const meta = [
  { dt: "Nombre", dd: sitio.nombreCorto },
  { dt: "Oficio", dd: sitio.oficio },
  { dt: "Lugar", dd: sitio.ciudad },
];
---

<section id="inicio" class="hero py-[2.8rem] pb-4">
  <div class="wrap grid items-stretch gap-5 desk:grid-cols-[1.4fr_0.9fr]">
    <Ticket class="ticket-hero">
      <header class="mb-3.5 flex items-center justify-between gap-4">
        <p class="kicker">Portafolio personal</p>
        <Stamp tono="amber" texto="Activo" />
      </header>
      <h1>
        Soy {sitio.nombre}.
        <em>Desarrollador.</em>
      </h1>
      <p class="lede">
        Escribo software de punta a punta: de la base de datos a la pantalla.
        Aprendí con PHP, MySQL y XAMPP; hoy trabajo sobre todo con Django. El
        proyecto con el que me presento es <strong>SIGMA</strong>, un sistema en
        producción.
      </p>
      <div class="mt-[1.4rem] flex flex-wrap gap-[0.7rem]">
        <a class="btn btn-ink" href="#sigma">Ver SIGMA</a>
        <a class="btn btn-ghost" href={sitio.github} rel="noopener noreferrer">GitHub</a>
      </div>
      <dl
        class="meta-row mt-7 grid grid-cols-2 gap-3 border-t border-dashed border-papel-borde pt-5 desk:grid-cols-4"
      >
        {
          meta.map((fila) => (
            <div>
              <dt>{fila.dt}</dt>
              <dd>{fila.dd}</dd>
            </div>
          ))
        }
        <div>
          <dt>Estado</dt>
          <dd><span class="led" aria-hidden="true"></span> Activo</dd>
        </div>
      </dl>
    </Ticket>

    <aside class="scope" aria-label="Resumen">
      <p class="scope-label">Resumen</p>
      <ul class="scope-stats">
        <li>
          <span>Estudio</span>
          <strong>CONALEP</strong>
        </li>
        <li>
          <span>Operación</span>
          <strong>2017+</strong>
        </li>
        <li>
          <span>Proyecto insignia</span>
          <strong>SIGMA</strong>
        </li>
        <li>
          <span>Stack actual</span>
          <strong>Django</strong>
        </li>
      </ul>
      <p class="scope-foot">Técnico en Informática · PHP de origen · Django en producción</p>
    </aside>
  </div>
</section>
