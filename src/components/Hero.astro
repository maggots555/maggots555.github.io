---
/**
 * Secuencia de título: el nombre ocupa el vacío de la izquierda.
 * La pintura (public/assets/chiaroscuro.jpg) vive a la derecha,
 * fundida al negro, como en el cuadro de referencia.
 */
import { sitio } from "../data/sitio";
import Ticket from "./Ticket.astro";

const meta = [
  { dt: "Nombre", dd: sitio.nombreCorto },
  { dt: "Oficio", dd: sitio.oficio },
  { dt: "Lugar", dd: sitio.ciudad },
];
---

<section id="inicio" class="hero">
  {/* Figura: capa de fondo. data-parallax = qué tanto se atrasa vs el scroll. */}
  <div class="hero-atmosphere" data-parallax="0.4" data-parallax-min="860" aria-hidden="true">
    <img src="/assets/chiaroscuro.jpg" alt="" width="1024" height="811" />
  </div>

  <div class="hero-copy" data-parallax="0.14" data-parallax-min="860">
    <Ticket class="panel-hero">
      <div class="hero-main">
        <h1>
          <span class="hero-soy">Soy</span>
          <span class="hero-name">Jorge Luis</span>
          <span class="hero-name">Magos</span>
          <span class="hero-name">Alvarez</span>
          <em>Desarrollador</em>
        </h1>
        <p class="lede">
          Escribo software de punta a punta: de la base de datos a la pantalla.
          Aprendí con PHP, MySQL y XAMPP; hoy trabajo sobre todo con Django. El
          proyecto con el que me presento es <strong class="text-papel">SIGMA</strong>, un sistema en
          producción.
        </p>
        <div class="hero-actions mt-[1.6rem] flex flex-wrap gap-[0.7rem]">
          <a class="btn btn-ink" href="#sigma">Ver SIGMA</a>
          <a class="btn btn-ghost" href={sitio.github} rel="noopener noreferrer">GitHub</a>
        </div>
        <dl
          class="meta-row mt-8 grid grid-cols-2 gap-3 border-t border-papel/15 pt-5"
        >
          {
            meta.map((fila) => (
              <div>
                <dt>{fila.dt}</dt>
                <dd>{fila.dd}</dd>
              </div>
            ))
          }
          <div>
            <dt>Estado</dt>
            <dd>Activo</dd>
          </div>
        </dl>
      </div>
    </Ticket>

    <ul class="hero-credits" aria-label="Resumen">
      <li>
        <span>Estudio</span>
        <strong>CONALEP</strong>
      </li>
      <li>
        <span>Operación</span>
        <strong>2017+</strong>
      </li>
      <li>
        <span>Proyecto insignia</span>
        <strong>SIGMA</strong>
      </li>
      <li>
        <span>Stack actual</span>
        <strong>Django</strong>
      </li>
    </ul>
    <p class="hero-foot">Técnico en Informática · PHP de origen · Django en producción</p>
  </div>
</section>
