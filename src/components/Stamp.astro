---
/**
 * Marca de estado (Activo, En producción, Origen).
 *
 * EXPLICACIÓN:
 * Ya no es un sello de goma rotado. Es una cursiva, como un crédito
 * al margen. `tono` solo cambia el color: amber (luz), teal (pátina), red (origen).
 */
interface Props {
  tono: "amber" | "teal" | "red";
  texto: string;
}

const { tono, texto } = Astro.props;

const claseTono = {
  amber: "stamp-amber",
  teal: "stamp-teal",
  red: "stamp-red",
}[tono];
---

<p class:list={["stamp", claseTono]}>{texto}</p>
