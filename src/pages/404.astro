---
import Layout from "../layouts/Layout.astro";
import Ticket from "../components/Ticket.astro";
---

<Layout title="Página no encontrada — Jorge Luis Magos" simple>
  <main class="wrap py-[16vh]">
    <Ticket>
      <p class="m-0 italic text-crema">Error 404</p>
      <h1 class="title-page">Esta página no existe.</h1>
      <p>El enlace está roto o la ruta cambió. Vuelve al inicio del portafolio.</p>
      <p class="mt-8">
        <a class="btn btn-ink" href="/">Ir al inicio</a>
      </p>
    </Ticket>
  </main>
</Layout>
